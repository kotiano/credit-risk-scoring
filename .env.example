# Copy to .env to override defaults. No secrets are required: the project runs on
# local, synthetic data in an embedded DuckDB warehouse.

# Location of the DuckDB warehouse file
CREDIT_RISK_DB_PATH=data/warehouse/credit_risk.duckdb

# Model artifacts, evaluation JSON and analytics CSVs
CREDIT_RISK_ARTIFACTS_DIR=artifacts

# Synthetic data generation
CREDIT_RISK_SEED=42
CREDIT_RISK_N_BORROWERS=5000

# Logging (DEBUG, INFO, WARNING, ERROR)
CREDIT_RISK_LOG_LEVEL=INFO

# DuckDB worker threads. 1 = bit-for-bit reproducible reports (default).
CREDIT_RISK_DUCKDB_THREADS=1
